    if q.exists():
        d=json.loads(q.read_text());d['version']='8.5.2'
        if f=='package-lock.json' and d.get('packages',{}).get('') is not None:d['packages']['']['version']='8.5.2'
        q.write_text(json.dumps(d,indent=2)+'\n')

Path('tests/loopobserver852.test.js').write_text(r'''const fs=require('fs'),path=require('path');const src=fs.readFileSync(path.join(__dirname,'../ghost-in-the-loop.user.js'),'utf8');
describe('v8.5.2 completion observer',()=>{
test('filters Socket.IO heartbeat frames',()=>{const a=src.indexOf('_wsFrameIsMeaningful(data)'),b=src.indexOf('_pulseWs(data)',a);const body=src.slice(a,b).replace('_wsFrameIsMeaningful(data)','function f(data)').replace(/},\s*$/,'}');const f=Function(body+';return f;')();for(const x of ['2','3','2probe','3probe','40','41','ping','pong','{"type":"heartbeat"}'])expect(f(x)).toBe(false);expect(f('42["answer",{"text":"hello"}]')).toBe(true);});
test('reads DOM before network veto',()=>{const t=src.slice(src.indexOf('function engineTick()'),src.indexOf('function startLoop()'));expect(t.indexOf('Adapter.getLastText()')).toBeLessThan(t.indexOf('Adapter.isGenerating()&&!terminalReady'));expect(t).toContain('network_generation_overridden');});
test('requires three independent terminal catches',()=>{expect(src).toContain("obs.stableTicks>=1");expect(src).toContain('_replyAdvancedBeyondBaseline(text)');expect(src).toContain('!stopVisible');});
test('Ghost-only reboot never reloads page or regrounds',()=>{const a=src.indexOf('function rebootGhost()'),b=src.indexOf('function ',a+20),x=src.slice(a,b);expect(x).toContain('Ticker.stop()');expect(x).toContain('mountPanel()');expect(x).not.toContain('location.reload');expect(x).not.toContain('regroundLoop');});
test('visible pipeline and separate drift region',()=>{expect(src).toContain('renderLoopPipeline()');expect(src).toContain('Run status');expect(src).toContain('g-prog>.g-safety{grid-column:2');});});
''')

ch=Path('CHANGELOG.md');x=ch.read_text();entry="""## [8.5.2] — completion observer, visible run stages, Ghost-only reboot

- Fixed Perplexity remaining in reading/waiting forever: Socket.IO heartbeat and control frames no longer count as generation output.
- Added three independent completion catches: a reply newer than the send baseline, a stable tail across two ticks, and no visible Stop control. Stable visible PROCEED/HALT can override stale network telemetry.
- Run status now shows Output → Marker check → Next command/HALT, including the real pre-send countdown. Drift guard is a separate right-hand section.
- Header ↻ now reloads Ghost only (timers, observers, caches, panel, tab lock, bus, selector detection) without reloading the long chat or sending a reground prompt. Selector-only re-detect remains in Diagnostics.
- Composer Rail now follows composer replacement and geometry with ResizeObserver, MutationObserver and a low-frequency check, still without a page-scroll listener or host-editor injection.

""";ch.write_text(x.replace('# Changelog\n\n','# Changelog\n\n'+entry))
d=Path('DEVLOG.md');x=d.read_text();entry="""## v8.5.2 — visible state machine and Perplexity heartbeat root cause

**Field evidence:** the saved Perplexity page showed Ghost booted and a completed response containing `[[GITL::PROCEED]]`, while Ghost still reported reading/waiting.

**Root cause:** v8.5.1 treated every frame on Perplexity's persistent Socket.IO connection as trusted generation traffic, including ping/pong and control frames. `engineTick()` therefore returned before reading the already-finished DOM response. A second contributor was treating a mounted-but-hidden Stop button as active.

**Earlier attempts that were real but insufficient:** disabling mobile visual effects fixed jank; layered Send fallbacks fixed a separate dispatch failure. Neither can repair a transition that never reaches signal reading or sending. Do not diagnose future cases as lag or send-selector failure until the visible stage pipeline identifies the failing transition.

**Chosen fix:** filter non-content WebSocket frames; require visible Stop evidence; and accept a terminal marker only when the response advanced beyond the pre-send baseline, remained stable across two ticks, and has no visible Stop control. Network is advisory and cannot veto those three independent DOM catches.

**Residual risk:** Perplexity can change its Socket.IO 