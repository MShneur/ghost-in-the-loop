from pathlib import Path
import json, re

p=Path('ghost-in-the-loop.user.js'); s=p.read_text()
def one(a,b,name):
    global s
    n=s.count(a)
    if n!=1: raise SystemExit(f'{name}: expected 1 match, got {n}')
    s=s.replace(a,b)
def after(a,b,name): one(a,a+b,name)

