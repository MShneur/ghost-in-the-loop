one("  $('#g-col')?.addEventListener", "  $('#g-redetect')?.addEventListener('click', rebootGhost);\n  $('#g-redetect-only')?.addEventListener('click', reDetect);\n  $('#g-col')?.addEventListener",'reboot binding')
